diff -ruN a/glamor/glamor_pixmap.c b/glamor/glamor_pixmap.c
--- a/glamor/glamor_pixmap.c	2026-07-08 03:21:12.000000000 +0200
+++ b/glamor/glamor_pixmap.c	2026-10-30 22:03:52.494999568 +0100
@@ -71,6 +71,33 @@
 
     glBindFramebuffer(GL_FRAMEBUFFER, fbo->fb);
     glViewport(x0, y0, width, height);
+    fbo->tod_scritta = tod_generazione;   /* tod: vedi tod_prima_di_leggere */
+}
+
+/* tod: alcuni driver (visto su Adreno 840) lasciano a volte partire la lettura di una texture (copia,
+ * composizione) prima di aver completato un disegno appena fatto dentro di essa: per un fotogramma la
+ * finestra esce compressa "a strisce", come letta con il passo di un'altra superficie. Prima di leggere
+ * una texture disegnata dopo l'ultima sincronizzazione se ne legge un pixel (glReadPixels), che obbliga il
+ * driver a completare il disegno; poi si passa alla generazione successiva, così un'attesa vale per tutte
+ * le texture disegnate fin lì (sul desktop 1-3 attese per fotogramma). Corretto con qualsiasi driver. */
+unsigned tod_generazione = 1;
+
+void
+tod_prima_di_leggere(glamor_pixmap_fbo *fbo)
+{
+    GLint vecchio = 0;
+    uint32_t px;
+
+    if (!fbo || fbo->tod_scritta != tod_generazione)
+        return;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &vecchio);
+    if (fbo->fb) {
+        glBindFramebuffer(GL_FRAMEBUFFER, fbo->fb);
+        glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, &px);
+    } else
+        glFinish();
+    glBindFramebuffer(GL_FRAMEBUFFER, vecchio);
+    tod_generazione++;
 }
 
